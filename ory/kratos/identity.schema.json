{
  "$id": "https://pixels-rover.local/schemas/identity/default",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pixels Rover Identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "name": {
          "type": "string",
          "title": "Name"
        },
        "affiliation": {
          "type": "string",
          "title": "Affiliation"
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    }
  }
}
