# Pixels Rover Backend Configuration
# Copy this file to .env and fill in the values

# LLM Configuration (required for analysis)
ROVER_LLM_MODEL=gpt-4o-mini
ROVER_LLM_API_KEY=sk-your-api-key-here
# ROVER_LLM_API_BASE=https://api.openai.com/v1  # Optional: custom API base

# Database
ROVER_DATABASE_URL=sqlite+aiosqlite:///./rover.db

# DuckDB
ROVER_DUCKDB_PATH=:memory:

# Pixels Server (optional)
ROVER_PIXELS_HOST=localhost
ROVER_PIXELS_PORT=18890

# JWT
ROVER_JWT_SECRET=change-me-in-production

# Analysis defaults
ROVER_DEFAULT_MAX_STEPS=10
ROVER_DEFAULT_MAX_LLM_CALLS=20
ROVER_DEFAULT_MAX_WALL_TIME_SEC=180
ROVER_DEFAULT_MAX_SQL_EXECUTIONS=5

# Debug
ROVER_DEBUG=false
