# APISIX Standalone YAML — routing and edge security headers only.
#
# Identity/session decisions are delegated to Ory Kratos + Ory Oathkeeper.
# APISIX remains the single external entrypoint and owns:
#   * /gateway/live and /gateway/ready
#   * public Ory UI / Kratos browser-flow exposure
#   * routing to the Oathkeeper-protected API edge
#   * CORS, CSP, security response headers, and X-Request-Id

routes:
  - id: gateway-live
    uri: /gateway/live
    methods: [GET]
    priority: 9999
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.header.content_type = "application/json"
              ngx.status = 200
              ngx.say('{"status":"UP","service":"gateway","version":"3.9.1"}')
              return ngx.exit(200)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: gateway-ready
    uri: /gateway/ready
    methods: [GET]
    priority: 9998
    plugins:
      gateway-ready:
        probes:
          - name: kratos
            uri: /__ready_probe/kratos
            timeout_ms: 1000
          - name: oathkeeper
            uri: /__ready_probe/oathkeeper
            timeout_ms: 1000
          - name: ory-ui
            uri: /__ready_probe/ory-ui
            timeout_ms: 1000
            success_statuses:
              - 200
              - 302
              - 303
          - name: assistant-service
            uri: /__ready_probe/assistant
            timeout_ms: 1000
        total_timeout_ms: 4000
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: deny-api-internal
    uri: /api/internal/*
    priority: 9990
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.status = 404
              return ngx.exit(404)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: deny-gateway-internal
    uri: /gateway/internal/*
    priority: 9990
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.status = 404
              return ngx.exit(404)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: deny-public-metrics
    uri: /metrics
    methods: [GET, HEAD]
    priority: 9989
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.status = 404
              return ngx.exit(404)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  # Ory self-service UI and Kratos public browser-flow endpoints.
  #
  # Method policy (architecture-tasks §9): from APISIX's perspective the Ory
  # UI is read-only — the UI container owns its own POSTs directly against
  # Kratos from inside its JS code; no public POST surface exists on `/ui*`.
  # Both `/ui` (exact) and `/ui/*` (prefix) therefore restrict to
  # `[GET, HEAD]` uniformly. Any other verb on either URI falls through
  # to the frontend SPA catch-all route below — a single, symmetric
  # downstream behavior for both URIs that replaces the earlier asymmetry
  # where only the exact `/ui` route was method-restricted.
  - id: ory-ui-root
    uri: /ui
    methods: [GET, HEAD]
    priority: 970
    upstream_id: ory-ui

  - id: ory-ui-assets
    uri: /ui/*
    methods: [GET, HEAD]
    priority: 980
    upstream_id: ory-ui

  - id: kratos-self-service
    uri: /self-service/*
    priority: 960
    upstream_id: kratos-public

  - id: kratos-sessions
    uri: /sessions/*
    priority: 959
    upstream_id: kratos-public

  - id: kratos-schemas
    uri: /schemas/*
    priority: 958
    upstream_id: kratos-public

  # Old first-party auth API is intentionally retired in the one-shot Ory cutover.
  - id: auth-api-retired-root
    uri: /api/v1/auth
    priority: 940
    plugins:
      mocking:
        response_status: 410
        content_type: application/json
        with_mock_header: false
        response_example: '{"code":410,"message":"Legacy auth API retired. Use Ory Kratos browser flows under /self-service/* and the Ory UI under /ui/*."}'
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: auth-api-retired
    uri: /api/v1/auth/*
    priority: 950
    plugins:
      mocking:
        response_status: 410
        content_type: application/json
        with_mock_header: false
        response_example: '{"code":410,"message":"Legacy auth API retired. Use Ory Kratos browser flows under /self-service/* and the Ory UI under /ui/*."}'
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  # ---- /api/v1/* — per-timeout-class gateway edge (architecture-tasks §Task 7) ----
  #
  # Historically a single `protected-api` route owned every
  # `/api/v1/*` request and was forced to carry the loosest timeout
  # the loudest SSE endpoint needed (900 s read_timeout, request
  # buffering off). That coupling is finding #4: tuning the SSE idle
  # window silently extended the REST 504 bound to 15 minutes.
  #
  # The fix is per-traffic-shape routes. `config/services.yaml`
  # declares a `timeout_class` for each backend service
  # (`standard` | `long_poll` | `sse`); for every entry whose class
  # is NOT `standard` we emit a more-specific APISIX route here with
  # the class's own timeout / buffering profile. Anything that
  # remains (all `standard` entries) falls through to the
  # `protected-api` fallback route with the tight REST read_timeout.
  #
  # Priority math: APISIX picks the highest-priority route when two
  # URIs match. Per-class routes use `priority: 810` so they sit
  # exactly `_OPENAPI_PRIORITY_MARGIN = 10` above the fallback's
  # `priority: 800` — the gateway.md §6.2 hard rule that
  # check-contracts.py :: route-prefix-priority-ordered enforces.
  #
  # Cross-cutting concerns (gateway-csrf + X-Auth-* header strip)
  # MUST be re-declared on every /api/v1/* route because
  # `proxy-rewrite` / `gateway-csrf` are per-route plugins — omitting
  # them on a new class-specific route would re-open the
  # X-Auth-* forgery surface (finding #2 regression) on that path.
  # The set of plugins below therefore mirrors what `protected-api`
  # declares, and is asserted identical by
  # `apisix-timeout-class-routes-match-services-yaml`.
  - id: assistant-analysis-sse
    uri: /api/v1/analysis*
    priority: 810
    timeout:
      connect: 5
      send: 60
      read: 1800
    plugins:
      gateway-csrf:
        csrf_protect: true
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
      proxy-control:
        request_buffering: false
    upstream_id: oathkeeper-proxy

  - id: protected-api
    uri: /api/v1/*
    priority: 800
    timeout:
      connect: 5
      send: 60
      read: 30
    plugins:
      gateway-csrf:
        csrf_protect: true
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
    upstream_id: oathkeeper-proxy

  - id: frontend
    name: frontend
    uri: /*
    priority: 1
    upstream_id: frontend

upstreams:
  - id: oathkeeper-proxy
    name: oathkeeper-proxy
    type: roundrobin
    nodes:
      "oathkeeper:4455": 1

  - id: kratos-public
    name: kratos-public
    type: roundrobin
    nodes:
      "kratos:4433": 1

  - id: ory-ui
    name: ory-ui
    type: roundrobin
    nodes:
      "ory-ui:4455": 1

  - id: frontend
    name: frontend
    type: roundrobin
    nodes:
      "frontend:80": 1

global_rules:
  - id: cors
    plugins:
      cors:
        allow_origins: "${CORS_ALLOWED_ORIGINS}"
        allow_methods: "GET,POST,PUT,PATCH,DELETE,OPTIONS"
        allow_headers: "Content-Type,Cookie,X-Request-Id,X-XSRF-TOKEN"
        expose_headers: "X-Request-Id"
        allow_credential: true
        max_age: 3600

  - id: security-headers
    plugins:
      response-rewrite:
        headers:
          set:
            X-Frame-Options: DENY
            X-Content-Type-Options: nosniff
            Referrer-Policy: strict-origin-when-cross-origin
            Permissions-Policy: "camera=(), microphone=(), geolocation=(), payment=()"
            Content-Security-Policy: "${GATEWAY_CSP_HEADER}"

  - id: request-id
    plugins:
      request-id:
        include_in_response: true
        header_name: X-Request-Id

#END
