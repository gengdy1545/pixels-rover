# APISIX Standalone YAML — routing and edge security headers only.
#
# Identity/session decisions are delegated to Ory Kratos + Ory Oathkeeper.
# APISIX remains the single external entrypoint and owns:
#   * /gateway/live and /gateway/ready
#   * public Ory UI / Kratos browser-flow exposure
#   * routing to the Oathkeeper-protected API edge
#   * CORS, CSP, security response headers, and X-Request-Id

routes:
  - id: gateway-live
    uri: /gateway/live
    methods: [GET]
    priority: 9999
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.header.content_type = "application/json"
              ngx.status = 200
              ngx.say('{"status":"UP","service":"gateway","version":"3.9.1"}')
              return ngx.exit(200)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: gateway-ready
    uri: /gateway/ready
    methods: [GET]
    priority: 9998
    plugins:
      gateway-ready:
        probes:
          - name: kratos
            uri: /__ready_probe/kratos
            timeout_ms: 1000
          - name: oathkeeper
            uri: /__ready_probe/oathkeeper
            timeout_ms: 1000
          - name: ory-policy-adapter
            uri: /__ready_probe/policy-adapter
            timeout_ms: 1000
          - name: ory-ui
            uri: /__ready_probe/ory-ui
            timeout_ms: 1000
          - name: assistant-service
            uri: /__ready_probe/assistant
            timeout_ms: 1000
        total_timeout_ms: 5000
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: deny-api-internal
    uri: /api/internal/*
    priority: 9990
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.status = 404
              return ngx.exit(404)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: deny-gateway-internal
    uri: /gateway/internal/*
    priority: 9990
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.status = 404
              return ngx.exit(404)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  # Ory self-service UI and Kratos public browser-flow endpoints.
  - id: ory-ui-root
    uri: /ui
    methods: [GET]
    priority: 970
    upstream_id: ory-ui

  - id: ory-ui-assets
    uri: /ui/*
    priority: 980
    upstream_id: ory-ui

  - id: kratos-self-service
    uri: /self-service/*
    priority: 960
    upstream_id: kratos-public

  - id: kratos-sessions
    uri: /sessions/*
    priority: 959
    upstream_id: kratos-public

  - id: kratos-schemas
    uri: /schemas/*
    priority: 958
    upstream_id: kratos-public

  # Old first-party auth API is intentionally retired in the one-shot Ory cutover.
  - id: auth-api-retired-root
    uri: /api/v1/auth
    priority: 940
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.header.content_type = "application/json"
              ngx.status = 410
              ngx.say('{"code":410,"message":"Legacy auth API retired. Use Ory Kratos browser flows under /self-service/* and the Ory UI under /ui/*."}')
              return ngx.exit(410)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: auth-api-retired
    uri: /api/v1/auth/*
    priority: 950
    plugins:
      serverless-pre-function:
        phase: rewrite
        functions:
          - |
            return function(conf, ctx)
              ngx.header.content_type = "application/json"
              ngx.status = 410
              ngx.say('{"code":410,"message":"Legacy auth API retired. Use Ory Kratos browser flows under /self-service/* and the Ory UI under /ui/*."}')
              return ngx.exit(410)
            end
    upstream:
      type: roundrobin
      nodes:
        "127.0.0.1:65535": 1

  - id: analysis-backends-root
    uri: /api/v1/analysis/backends
    methods: [GET, OPTIONS]
    priority: 910
    plugins:
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
    upstream_id: oathkeeper-proxy

  - id: analysis-backends-detail
    uri: /api/v1/analysis/backends/*
    priority: 920
    plugins:
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
    upstream_id: oathkeeper-proxy

  - id: analysis-submit
    uri: /api/v1/analysis
    methods: [POST, OPTIONS]
    priority: 880
    timeout:
      connect: 5
      send: 60
      read: 900
    plugins:
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
      proxy-control:
        request_buffering: false
    upstream_id: oathkeeper-proxy

  - id: analysis-detail
    uri: /api/v1/analysis/*
    priority: 890
    plugins:
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
    upstream_id: oathkeeper-proxy

  - id: conversations-root
    uri: /api/v1/conversations
    methods: [GET, POST, OPTIONS]
    priority: 860
    plugins:
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
    upstream_id: oathkeeper-proxy

  - id: conversations-detail
    uri: /api/v1/conversations/*
    priority: 850
    plugins:
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
    upstream_id: oathkeeper-proxy

  - id: semantic-protected
    uri: /api/v1/semantic/*
    priority: 840
    plugins:
      proxy-rewrite:
        headers:
          remove: [X-Auth-User-Id, X-Auth-User-Email, X-Auth-Session-Id]
    upstream_id: oathkeeper-proxy

  - id: frontend
    name: frontend
    uri: /*
    priority: 1
    upstream_id: frontend

upstreams:
  - id: oathkeeper-proxy
    name: oathkeeper-proxy
    type: roundrobin
    nodes:
      "ory-policy-adapter:8080": 1

  - id: kratos-public
    name: kratos-public
    type: roundrobin
    nodes:
      "kratos:4433": 1

  - id: ory-ui
    name: ory-ui
    type: roundrobin
    nodes:
      "ory-ui:4455": 1

  - id: frontend
    name: frontend
    type: roundrobin
    nodes:
      "frontend:80": 1

global_rules:
  - id: cors
    plugins:
      cors:
        allow_origins: "${CORS_ALLOWED_ORIGINS}"
        allow_methods: "GET,POST,PUT,PATCH,DELETE,OPTIONS"
        allow_headers: "Authorization,Content-Type,Cookie,X-Request-Id,X-XSRF-TOKEN,X-CSRF-Token"
        expose_headers: "X-Request-Id"
        allow_credential: true
        max_age: 3600

  - id: security-headers
    plugins:
      response-rewrite:
        headers:
          set:
            X-Frame-Options: DENY
            X-Content-Type-Options: nosniff
            Referrer-Policy: strict-origin-when-cross-origin
            Permissions-Policy: "camera=(), microphone=(), geolocation=(), payment=()"
            Content-Security-Policy: "${GATEWAY_CSP_HEADER}"

  - id: request-id
    plugins:
      request-id:
        include_in_response: true
        header_name: X-Request-Id

#END
