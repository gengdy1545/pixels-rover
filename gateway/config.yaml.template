apisix:
  node_listen: 9080
  enable_ipv6: false

deployment:
  role: traditional
  role_traditional:
    config_provider: etcd
  admin:
    admin_listen:
      ip: 0.0.0.0
      port: 9180
    allow_admin:
      - 0.0.0.0/0
    admin_key:
      - name: admin
        key: ${APISIX_ADMIN_API_KEY}
        role: admin
  etcd:
    host:
      - http://etcd:2379
    prefix: /apisix
    timeout: 30

nginx_config:
  error_log: /dev/stderr
  http_configuration_snippet: |
    lua_shared_dict gateway_auth_cache 10m;

plugins:
  - proxy-rewrite
  - cors
  - request-id
  - prometheus
  - gateway-auth
