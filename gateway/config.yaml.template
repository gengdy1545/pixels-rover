# APISIX boot configuration (Standalone YAML mode).

apisix:
  node_listen: 9080
  enable_ipv6: false
  extra_lua_path: "/usr/local/apisix/?.lua"

deployment:
  role: data_plane
  role_data_plane:
    config_provider: yaml

nginx_config:
  error_log: /dev/stderr
  error_log_level: warn

  http_server_configuration_snippet: |
    location = /__ready_probe/kratos {
      internal;
      proxy_connect_timeout 1s;
      proxy_send_timeout    1s;
      proxy_read_timeout    1s;
      proxy_pass http://kratos:4433/health/ready;
    }
    location = /__ready_probe/oathkeeper {
      internal;
      proxy_connect_timeout 1s;
      proxy_send_timeout    1s;
      proxy_read_timeout    1s;
      proxy_pass http://oathkeeper:4456/health/ready;
    }
    location = /__ready_probe/policy-adapter {
      internal;
      proxy_connect_timeout 1s;
      proxy_send_timeout    1s;
      proxy_read_timeout    1s;
      proxy_pass http://ory-policy-adapter:8080/health;
    }
    location = /__ready_probe/ory-ui {
      internal;
      proxy_connect_timeout 1s;
      proxy_send_timeout    1s;
      proxy_read_timeout    1s;
      proxy_pass http://ory-ui:4455/ui/login;
    }
    location = /__ready_probe/assistant {
      internal;
      proxy_connect_timeout 1s;
      proxy_send_timeout    1s;
      proxy_read_timeout    1s;
      proxy_pass http://assistant-service:8090/internal/ready;
    }

plugins:
  - gateway-ready
  - cors
  - proxy-rewrite
  - proxy-control
  - request-id
  - response-rewrite
  - serverless-pre-function
  - prometheus
