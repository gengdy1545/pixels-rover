# Pixels Rover — Docker Compose Environment Variables
#
# This file is AUTO-GENERATED from config/required-env.yaml by
# scripts/generate-env-example.py. Do NOT hand-edit — your change will
# be overwritten the next time the generator runs, and the PR-gate
# contract check `env-example-matches-required-env-yaml` will fail.
#
# Workflow to add / modify an env var:
#   1. Edit config/required-env.yaml (the single source of truth).
#   2. Run: python3 scripts/generate-env-example.py
#   3. Commit both files in the same PR.
#
# Layout:
#   * Required block — one banner per service / deployment component. Each
#     var has its description, constraints, and assignment line;
#     `sensitive: true` entries render as `KEY=` (empty) — you MUST fill
#     them in your local .env before `docker compose up`.
#   * Optional block (footer) — commonly-tuned knobs that docker-compose.yml
#     already carries sensible defaults for. Listed here for operator
#     convenience; safe to leave unset.
#
# See docs/development/backend.md §13 for the "FATAL-on-missing" rule
# that each service's RequiredEnvValidator implements.


# ==== gateway ====

# Comma-separated list of allowed origins for CORS pre-flight responses.
# APISIX renders this value into its cors plugin. "*" is forbidden in
# production; use docker-compose.dev.yml for local defaults.
# REQUIRED (always)
# FORBIDDEN VALUES: '*'
CORS_ALLOWED_ORIGINS=

# Content-Security-Policy profile selector. "production" emits the
# strict CSP (no unsafe-inline, no unsafe-eval); "development" emits the
# looser CSP allowing Vite's HMR websocket. Empty / any other value is a
# fatal boot error — gateway.md §6.6 forbids a default so every
# deployment makes an explicit choice.
# REQUIRED (always)
# ALLOWED VALUES: production, development
GATEWAY_CSP_PROFILE=production

# ==== ory-deployment ====

# External browser-facing base URL for Kratos browser flows and Ory UI
# redirects, for example https://rover.example.com. Production must set
# the real HTTPS origin; docker-compose.dev.yml supplies
# http://localhost for local development only.
# REQUIRED (always)
# FORBIDDEN VALUES: 'change-me', '<set-me>'
PUBLIC_BASE_URL=

# ==== kratos ====

# Ory Kratos default cryptographic secret. Rotate with care because
# changing it can invalidate encrypted/signature-protected state.
# REQUIRED (always)
# FORBIDDEN VALUES: 'change-me', '<set-me>'
# MINIMUM LENGTH: 32 UTF-8 bytes
# SENSITIVE — supply before first boot; never commit a real value
KRATOS_SECRET_DEFAULT=

# Ory Kratos cookie signing/encryption secret for browser sessions.
# REQUIRED (always)
# FORBIDDEN VALUES: 'change-me', '<set-me>'
# MINIMUM LENGTH: 32 UTF-8 bytes
# SENSITIVE — supply before first boot; never commit a real value
KRATOS_SECRET_COOKIE=

# ==== ory-ui ====

# Cookie and CSRF secret for the Ory self-service UI container. Must be
# deployment-local and must not be committed.
# REQUIRED (always)
# FORBIDDEN VALUES: 'change-me', '<set-me>'
# MINIMUM LENGTH: 32 UTF-8 bytes
# SENSITIVE — supply before first boot; never commit a real value
ORY_UI_COOKIE_SECRET=

# ==== assistant-service ====

# API key for the configured LLM provider (OpenAI-compatible). Empty or
# placeholder values disable analysis outright; we fail fast rather than
# serving 500s on the first /analysis submit.
# REQUIRED (always)
# FORBIDDEN VALUES: 'sk-your-api-key-here', '<set-me>'
# SENSITIVE — supply before first boot; never commit a real value
ROVER_LLM_API_KEY=

# SQLAlchemy async URL for pixels_analysis. Alembic upgrade head runs
# against this URL from entrypoint.sh before uvicorn binds the port
# (backend.md §12.2); a missing URL would leave the service in a half-
# migrated state invisible from /internal/ready.
# REQUIRED (always)
ROVER_DATABASE_URL=

# URL of Oathkeeper's JWKS endpoint, e.g. http://oathkeeper:4456/.well-
# known/jwks.json. The backend fetches the signing keys from here (with
# short TTL cache) to verify the Bearer JWT that Oathkeeper's id_token
# mutator injects. MUST be reachable from the assistant-service
# container; compose's internal DNS makes this a stable host without
# exposing the port externally (architecture-tasks §Task 8).
# REQUIRED (always)
OATHKEEPER_JWKS_URL=http://oathkeeper:4456/.well-known/jwks.json

# Expected `iss` claim on the Oathkeeper-issued JWT. Must match
# Oathkeeper's id_token mutator `issuer_url` setting in
# config/ory/oathkeeper/oathkeeper.yml. Decoupling the expected value
# here (instead of hardcoding in app code) lets staging vs production
# run with different issuer strings without a code change.
# REQUIRED (always)
OATHKEEPER_JWT_ISSUER=https://pixels-rover.local/oathkeeper

# Expected `aud` claim on the Oathkeeper-issued JWT. Pins the JWT to the
# assistant-service audience so a token leaked from a hypothetical
# future sibling backend cannot be replayed against this one. Must match
# Oathkeeper's id_token mutator `audience` list.
# REQUIRED (always)
OATHKEEPER_JWT_AUDIENCE=pixels-rover-assistant

# Master switch for the Task 8 verifier. "true" in every non-test
# runtime (production, staging, dev-compose) — the backend rejects
# requests without a valid Oathkeeper JWT with 401
# GATEWAY_SUBJECT_UNVERIFIED. "false" is reserved for pytest / unit-test
# harnesses that bypass the JWT layer entirely via
# ROVER_REQUIRED_ENV_SKIP=1; never ship "false" in a real deployment.
# REQUIRED (always)
# ALLOWED VALUES: true, false
OATHKEEPER_JWT_REQUIRED=true

# ==== Optional (docker-compose.yml carries defaults) ====

# LLM provider knobs (also see ROVER_LLM_API_KEY above — that one is required).
# LLM_MODEL=gpt-4o-mini
# LLM_API_BASE=https://api.openai.com/v1

# MySQL root + app passwords and port. The app user is created by
# db/pixels_rover.sql (initdb.d, first-boot only).
# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_PASSWORD=password
# MYSQL_PORT=3306

# External port the API gateway (APISIX) listens on. All traffic enters
# here; backend services are not directly exposed.
# GATEWAY_PORT=80

# Pixels-server (used by assistant-service when querying Pixels-backed schemas).
# PIXELS_HOST=host.docker.internal
# PIXELS_PORT=18890

# Assistant-service debug toggle. Keep this project-scoped instead of DEBUG to
# avoid colliding with shell/debugger-provided DEBUG values.
# ROVER_DEBUG=false

# DuckDB storage path. The compose default is persistent and mounted on the
# assistant-duckdb named volume. Set ROVER_DUCKDB_PATH=:memory: for throwaway
# local demos/tests; that mode loses analysis data on restart.
# ROVER_DUCKDB_PATH=/var/lib/pixels-rover/duckdb/analysis.duckdb

# ==== Optional frontend build-time overrides ====

# Vite-time override for the frontend's axios + SSE baseURL. Unset
# preserves same-origin behaviour (the bundle's host becomes the API
# host), which is what production ships. Local dev against a remote
# gateway (or a future non-browser client pointing at a specific host)
# sets this at build time, e.g. `VITE_API_BASE=http://localhost:9080`.
# See frontend/src/shared/api/client.ts#resolveApiUrl.
# VITE_API_BASE=
