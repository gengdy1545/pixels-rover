# Pixels Rover — Docker Compose Environment Variables
#
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#

# ---- LLM Configuration (required for analysis) ----
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-api-key-here
# LLM_API_BASE=https://api.openai.com/v1

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=password
# MYSQL_PORT=3306

# ---- JWT ----
JWT_KID=dev-rsa-1

# ---- Pixels Server (optional) ----
# PIXELS_HOST=host.docker.internal
# PIXELS_PORT=18890

# ---- Port Overrides ----
# All traffic enters through the API Gateway on this port.
# Backend services (auth, analysis, frontend) are internal only.
GATEWAY_PORT=80
# MYSQL_PORT=3306

# ---- Debug ----
# DEBUG=false
