# Pixels Rover — Docker Compose Environment Variables
#
# This file is AUTO-GENERATED from config/required-env.yaml by
# scripts/generate-env-example.py. Do NOT hand-edit — your change will
# be overwritten the next time the generator runs, and the PR-gate
# contract check `env-example-matches-required-env-yaml` will fail.
#
# Workflow to add / modify an env var:
#   1. Edit config/required-env.yaml (the single source of truth).
#   2. Run: python3 scripts/generate-env-example.py
#   3. Commit both files in the same PR.
#
# Layout:
#   * Required block — one banner per service (gateway / auth-service /
#     assistant-service). Each var has its description, constraints,
#     and assignment line; `sensitive: true` entries render as `KEY=`
#     (empty) — you MUST fill them in your local .env before
#     `docker compose up`.
#   * Optional block (footer) — commonly-tuned knobs that docker-compose.yml
#     already carries sensible defaults for. Listed here for operator
#     convenience; safe to leave unset.
#
# See docs/development/backend.md §13 for the "FATAL-on-missing" rule
# that each service's RequiredEnvValidator implements.


# ==== gateway ====

# Shared secret the gateway sends in X-Internal-Auth when it calls auth-
# service's /api/internal/auth/introspect. auth-service rejects
# introspect requests whose header does not match.
# REQUIRED (always)
# FORBIDDEN VALUES: 'change-me', '<set-me>'
# MINIMUM LENGTH: 16 UTF-8 bytes
# SENSITIVE — supply before first boot; never commit a real value
INTERNAL_INTROSPECTION_SECRET=

# Shared secret the gateway sends in X-Internal-Auth when auth-service
# invokes POST /gateway/internal/invalidate_session (§7.4 session
# invalidation / A1+A3). Distinct from INTROSPECTION_SECRET so the two
# calling directions can be rotated independently.
# REQUIRED (always)
# FORBIDDEN VALUES: 'change-me', '<set-me>'
# MINIMUM LENGTH: 16 UTF-8 bytes
# SENSITIVE — supply before first boot; never commit a real value
INTERNAL_GATEWAY_ADMIN_SECRET=

# Comma-separated list of allowed origins for CORS pre-flight responses.
# Gateway rejects requests from any other Origin with 403
# GATEWAY_CORS_DENIED (see gateway.md §6.6). "*" is forbidden in
# production; use docker-compose.dev.yml override to relax for local
# dev.
# REQUIRED (always)
# FORBIDDEN VALUES: '*'
CORS_ALLOWED_ORIGINS=

# Content-Security-Policy profile selector. "production" emits the
# strict CSP (no unsafe-inline, no unsafe-eval); "development" emits the
# looser CSP allowing Vite's HMR websocket. Empty / any other value is a
# fatal boot error — gateway.md §6.6 forbids a default so every
# deployment makes an explicit choice.
# REQUIRED (always)
# ALLOWED VALUES: production, development
GATEWAY_CSP_PROFILE=production

# OpenAPI exposure profile selector (gateway.md §6.7). "true" serves
# /api/v1/{auth,analysis}/openapi.json anonymously; "false" requires a
# valid session. No default — every deployment must decide explicitly.
# NEVER ship "true" to production.
# REQUIRED (always)
# ALLOWED VALUES: true, false
GATEWAY_OPENAPI_PUBLIC=false

# ==== auth-service ====

# Signing algorithm for access + refresh tokens. "HS256" is symmetric
# (single shared secret); "RS256" is asymmetric (private key signs,
# public key verifies, and enables rotation via jwt.public-keys-
# directory). See docs/design/jwt-rotation.md.
# REQUIRED (always)
# ALLOWED VALUES: HS256, RS256
JWT_ALGORITHM=HS256

# HS256 shared secret, Base64-encoded (jjwt decodes before use). Minimum
# 32 UTF-8 bytes. MUST be empty when JWT_ALGORITHM=RS256 (mutual
# exclusion; validator refuses boot on co-presence).
# REQUIRED when JWT_ALGORITHM=HS256
# MUST BE UNSET when JWT_ALGORITHM=RS256
# FORBIDDEN VALUES: 'change-me', '<set-me>'
# MINIMUM LENGTH: 32 UTF-8 bytes
# SENSITIVE — supply before first boot; never commit a real value
JWT_SECRET=

# RS256 private-key PEM path inside the auth-service container.
# Validator opens and parses the file at boot; a missing / unreadable /
# malformed PEM fails the boot. In docker compose the key directory is
# bind-mounted from ./keys/jwt/ (prod) or a jwt-keys named volume
# populated by the dev override (see docs/runbooks/jwt-key-
# provisioning.md).
# REQUIRED when JWT_ALGORITHM=RS256
# MUST BE UNSET when JWT_ALGORITHM=HS256
# MUST be a readable file path at container-start time
JWT_PRIVATE_KEY_PATH=

# RS256 public-key PEM path (used as the ACTIVE verify key). Validator
# parses the PEM AND performs a sign→verify self-test using
# JWT_PRIVATE_KEY_PATH to prove the pair is a valid RSA keypair before
# admission.
# REQUIRED when JWT_ALGORITHM=RS256
# MUST BE UNSET when JWT_ALGORITHM=HS256
# MUST be a readable file path at container-start time
JWT_PUBLIC_KEY_PATH=

# Key-id claim stamped into the JWT header ("kid"). Clients /
# introspection code use it to pick the correct verify key. Forbidden
# placeholder values catch operators who leave the dev-time kid in a
# production config.
# REQUIRED when JWT_ALGORITHM=RS256
# MUST BE UNSET when JWT_ALGORITHM=HS256
# FORBIDDEN VALUES: 'default-hmac', 'dev-rsa-1', '<set-me>'
JWT_ACTIVE_KID=

# MUST match the value shipped to the gateway (see gateway.*). auth-
# service's SecurityConfig rejects /api/internal/auth/introspect callers
# whose X-Internal-Auth header does not equal this value.
# REQUIRED (always)
# FORBIDDEN VALUES: 'change-me', '<set-me>'
# MINIMUM LENGTH: 16 UTF-8 bytes
# SENSITIVE — supply before first boot; never commit a real value
INTERNAL_INTROSPECTION_SECRET=

# ==== assistant-service ====

# API key for the configured LLM provider (OpenAI-compatible). Empty or
# placeholder values disable analysis outright; we fail fast rather than
# serving 500s on the first /analysis submit.
# REQUIRED (always)
# FORBIDDEN VALUES: 'sk-your-api-key-here', '<set-me>'
# SENSITIVE — supply before first boot; never commit a real value
ROVER_LLM_API_KEY=

# SQLAlchemy async URL for pixels_analysis. Alembic upgrade head runs
# against this URL from entrypoint.sh before uvicorn binds the port
# (backend.md §12.2); a missing URL would leave the service in a half-
# migrated state invisible from /internal/ready.
# REQUIRED (always)
ROVER_DATABASE_URL=

# ==== Optional (docker-compose.yml carries defaults) ====

# LLM provider knobs (also see ROVER_LLM_API_KEY above — that one is required).
# LLM_MODEL=gpt-4o-mini
# LLM_API_BASE=https://api.openai.com/v1

# MySQL root + app passwords and port. The app user is created by
# db/pixels_rover.sql (initdb.d, first-boot only).
# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_PASSWORD=password
# MYSQL_PORT=3306

# External port the API gateway (APISIX) listens on. All traffic enters
# here; backend services are not directly exposed.
# GATEWAY_PORT=80

# Pixels-server (used by assistant-service when querying Pixels-backed schemas).
# PIXELS_HOST=host.docker.internal
# PIXELS_PORT=18890

# Cookie behaviour. COOKIE_SECURE=true REQUIRES HTTPS at the edge.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=Lax
# COOKIE_DOMAIN=

# Debug toggles.
# DEBUG=false

# docker-compose.dev.yml override ONLY — ignored by the production
# compose file. The dev override runs a throw-away jwt-keygen container
# that provisions RS256 keys for <JWT_KID>-{private,public}.pem so the
# first-time local boot doesn't require manual openssl steps. For
# production, use the bind-mounted ./keys/jwt/ directory instead (see
# docs/runbooks/jwt-key-provisioning.md).
# JWT_KID=dev-rsa-1
