# Pixels Rover — Docker Compose Environment Variables
#
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#

# ---- LLM Configuration (required for analysis) ----
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-api-key-here
# LLM_API_BASE=https://api.openai.com/v1

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=password
# MYSQL_PORT=3306

# ---- JWT ----
JWT_KID=dev-rsa-1
APISIX_ADMIN_API_KEY=change-me-admin-key
INTERNAL_INTROSPECTION_SECRET=change-me

# ---- Pixels Server (optional) ----
# PIXELS_HOST=host.docker.internal
# PIXELS_PORT=18890

# ---- Port Overrides ----
# All traffic enters through the API Gateway on this port.
# Backend services (auth, analysis, frontend) are internal only.
GATEWAY_PORT=80
# MYSQL_PORT=3306

# ---- Cookie Configuration (Gateway) ----
# Set to true in production with HTTPS
# COOKIE_SECURE=false
# SameSite policy: Lax for dev/prod
# COOKIE_SAMESITE=Lax
# Leave empty for localhost; set to your domain in production
# COOKIE_DOMAIN=
# Access token max age in seconds (default: 1 hour)
# ACCESS_TOKEN_MAX_AGE=3600
# Refresh token max age in seconds (default: 7 days)
# REFRESH_TOKEN_MAX_AGE=604800

# ---- CORS Configuration (Gateway) ----
# Comma-separated list of allowed origins for CORS.
# Use '*' to allow all origins (development only).
# Examples:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
#   CORS_ALLOWED_ORIGINS=https://app.example.com
#   CORS_ALLOWED_ORIGINS=http://192.168.1.100:8080
# CORS_ALLOWED_ORIGINS=*

# ---- Debug ----
# DEBUG=false
