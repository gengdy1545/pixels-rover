# Pixels Rover — Docker Compose Environment Variables
#
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#

# ---- LLM Configuration (required for analysis) ----
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-api-key-here
# LLM_API_BASE=https://api.openai.com/v1

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PASSWORD=password
# MYSQL_PORT=3306

# ---- JWT ----
JWT_KID=dev-rsa-1

# ---- Gateway <-> auth-service shared secret ----
# Gateway's gateway-auth plugin sends this in X-Internal-Auth when it
# calls auth-service's /api/internal/auth/introspect. auth-service
# rejects any introspect request with a mismatching secret.
# gateway/entrypoint.sh fails fast if this is missing.
INTERNAL_INTROSPECTION_SECRET=change-me

# ---- Gateway OpenAPI exposure profile ----
# Strict enum: "true" | "false". gateway/entrypoint.sh fails fast on
# empty / invalid values; there is no default — every deployment must
# choose explicitly (see docs/development/gateway.md §6.7 for the
# "never default true" rule). Meaning:
#   * true  — /api/v1/{auth,analysis}/openapi.json is accessible
#             without login (DEV / pre-prod debugging only)
#   * false — /api/v1/{auth,analysis}/openapi.json requires a valid
#             session (PROD baseline; anonymous access returns 401)
# NEVER ship `GATEWAY_OPENAPI_PUBLIC=true` to production.
GATEWAY_OPENAPI_PUBLIC=false

# ---- Pixels Server (optional) ----
# PIXELS_HOST=host.docker.internal
# PIXELS_PORT=18890

# ---- Port Overrides ----
# All traffic enters through the API Gateway on this port.
# Backend services (auth, analysis, frontend) are internal only.
GATEWAY_PORT=80
# MYSQL_PORT=3306

# ---- Cookie Configuration (Gateway) ----
# Set to true in production with HTTPS
# COOKIE_SECURE=false
# SameSite policy: Lax for dev/prod
# COOKIE_SAMESITE=Lax
# Leave empty for localhost; set to your domain in production
# COOKIE_DOMAIN=
# Access token max age in seconds (default: 1 hour)
# ACCESS_TOKEN_MAX_AGE=3600
# Refresh token max age in seconds (default: 7 days)
# REFRESH_TOKEN_MAX_AGE=604800

# ---- CORS Configuration (Gateway) ----
# Comma-separated list of allowed origins for CORS.
# Use '*' to allow all origins (development only).
# Examples:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
#   CORS_ALLOWED_ORIGINS=https://app.example.com
#   CORS_ALLOWED_ORIGINS=http://192.168.1.100:8080
# CORS_ALLOWED_ORIGINS=*

# ---- Debug ----
# DEBUG=false
