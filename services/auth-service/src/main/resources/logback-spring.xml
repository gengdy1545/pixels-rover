<configuration>
    <property name="SERVICE_NAME" value="auth-service"/>

    <!--
        Unified log format for Pixels Rover services.
        Fields: timestamp level [service] [req:requestId] [user:userId] logger - message
        Log level conventions:
          DEBUG - Development diagnostics (SQL, JWT details)
          INFO  - Normal business flow (request received, login success, task started/completed)
          WARN  - Recoverable anomalies (token near expiry, retry, budget approaching limit)
          ERROR - Unrecoverable failures (DB connection lost, unhandled exception, task failed)
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [${SERVICE_NAME}] [req:%X{requestId:-N/A}] [user:%X{userId:-N/A}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Suppress noisy third-party loggers -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
