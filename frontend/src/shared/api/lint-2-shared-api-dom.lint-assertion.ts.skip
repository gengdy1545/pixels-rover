/**
 * lint-2 probe — 纪律 2（shared/api/ 不得直接访问 document/window/localStorage/sessionStorage）
 *
 * 本文件必须放在 `src/shared/api/**` 下才能命中 `.eslintrc.cjs` 里针对
 * `src/shared/api/**\/*.{ts,tsx}` 的 `no-restricted-syntax` overrides。
 *
 * 验证方式：
 *   1. `cp lint-2-shared-api-dom.lint-assertion.ts.skip lint-2-shared-api-dom.lint-assertion.ts`
 *   2. `cd frontend && npm run lint`
 *   3. 预期输出：该文件 ≥4 处 `no-restricted-syntax` error，消息以
 *      "shared/api 不允许直接访问 document / window / localStorage / sessionStorage" 开头。
 *   4. `rm lint-2-shared-api-dom.lint-assertion.ts`。
 *
 * 实现路径备注（frontend.md §3.4）：
 *   首选 `no-restricted-globals` 在 TS 项目里对 `lib.dom.d.ts` 声明的全局通常放行，
 *   所以这里最终采用 `no-restricted-syntax` + AST 选择器
 *   `MemberExpression[object.name=/^(document|window|localStorage|sessionStorage)$/]`。
 *   本 probe 就是"规则实际触发"合规判据的证据。
 */

// @ts-nocheck

export function probeDocument(): string {
  return document.cookie;
}

export function probeWindow(): string {
  return window.location.href;
}

export function probeLocalStorage(): string | null {
  return localStorage.getItem('token');
}

export function probeSessionStorage(): string | null {
  return sessionStorage.getItem('token');
}
